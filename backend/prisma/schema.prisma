generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())

  name          String?
  email         String   @unique

  password      String?

  googleId      String?  @unique
  profilePic    String?

  provider      String   @default("local")

  level         Int      @default(3)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}